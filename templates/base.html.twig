<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Emailer Light{% endblock %}</title>
        <link rel="icon" href="{{ asset('identity/favicon.ico') }}" sizes="any">
        <link rel="icon" href="{{ asset('identity/favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('identity/icon-180.png') }}" sizes="180x180">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
        <footer class="source-footer"><a href="https://github.com/Attory/emailer-light">Source code and license</a></footer>
    </body>
</html>
