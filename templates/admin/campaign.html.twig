{% extends 'admin/layout.html.twig' %}
{% block title %}{{ campaign.name ?: 'Untitled campaign draft' }} — Emailer Light{% endblock %}
{% block javascripts %}<script type="module" src="{{ asset('campaign-progress.js') }}"></script>{% endblock %}
{% block admin_body %}
<p><a href="{{ path('admin_campaigns') }}">← Campaigns</a></p>
{% if campaign.state in ['draft', 'review'] and campaign.missing_for_review %}<section class="panel alert"><h2>Draft saved — finish before review</h2><ul>{% for missing in campaign.missing_for_review %}<li>{{ missing }}</li>{% endfor %}</ul><a href="{{ path('admin_campaign_edit', {id: campaign.id}) }}">Continue this campaign draft</a></section>{% endif %}
<div class="page-heading"><div><p class="eyebrow">Campaign</p><h1>{{ campaign.name ?: 'Untitled campaign draft' }}</h1><span class="status-pill" data-state="{{ campaign.state }}" data-campaign-state>{{ campaign.state|replace({'_':' '})|title }}</span></div>{% if campaign.state in ['draft', 'review'] %}<a class="button secondary" href="{{ path('admin_campaign_edit', {id: campaign.id}) }}">Edit draft</a>{% endif %}</div>
{% if campaign.state in ['draft', 'review'] %}
<section class="panel"><h2>Campaign recipients</h2><p>{{ campaign.review.selected_count }} unique addresses; {{ campaign.review.suppressed_count }} currently suppressed. Suppression is checked again before each send.</p>
{% if campaign.recipient_preview %}<details><summary>Preview first {{ campaign.recipient_preview|length }} addresses</summary><ul>{% for recipient in campaign.recipient_preview %}<li>{{ recipient.email_canonical }}</li>{% endfor %}</ul></details>{% endif %}
<form method="post" action="{{ path('admin_campaign_recipients_replace', {id: campaign.id}) }}" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('campaign-recipients-replace-' ~ campaign.id) }}"><label>Replace with a new campaign CSV <input type="file" name="recipient_csv" accept="text/csv,.csv" required></label><button type="submit">Replace recipients</button></form>
{% if campaign.review.selected_count > 0 %}<form method="post" action="{{ path('admin_campaign_recipients_delete', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-recipients-delete-' ~ campaign.id) }}"><button type="submit" class="danger">Delete uploaded recipients</button></form>{% endif %}
<p class="help">Replacing or deleting resets the campaign to draft and invalidates the previous test. Approval locks this snapshot permanently.</p></section>
<section class="panel"><h2>Preview, test and approve</h2><p>{% if campaign.template_version_id %}<a href="{{ path('admin_template_preview', {versionId: campaign.template_version_id}) }}" target="_blank" rel="noopener">Preview template ↗</a>{% else %}No template selected. <a href="{{ path('admin_campaign_edit', {id: campaign.id}) }}">Complete draft</a>{% endif %}</p><p>Latest test: {{ campaign.latest_test ? campaign.latest_test.state : 'Not run' }}{% if campaign.latest_test and not campaign.latest_test.current_revision %} (previous revision){% endif %}</p>
<div class="actions"><form method="post" action="{{ path('admin_campaign_test', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-test-' ~ campaign.id) }}"><button{% if not campaign.can_test %} disabled{% endif %}>Send test to administrator</button></form>
{% if campaign.state == 'draft' %}<form method="post" action="{{ path('admin_campaign_review', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-review-' ~ campaign.id) }}"><button class="secondary"{% if not campaign.can_review %} disabled{% endif %}>Submit for review</button></form>{% endif %}</div>
{% if campaign.state == 'review' %}<form method="post" action="{{ path('admin_campaign_approve', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-approve-' ~ campaign.id) }}"><input type="hidden" name="reviewed_revision" value="{{ campaign.operation_version }}"><label><input type="checkbox" name="waive_test" value="1"> Skip the test (audited)</label><button>Approve and lock recipients</button></form>{% endif %}
</section>
{% endif %}
<section class="panel"><h2>Delivery progress</h2><div data-campaign-progress data-progress-url="{{ path('admin_campaign_progress', {id: campaign.id}) }}" data-initial-state="{{ campaign.state }}"><progress max="100" value="{{ campaign.progress.percent }}">{{ campaign.progress.percent }}%</progress><p><span data-processed>{{ campaign.progress.processed }}</span> of <span data-total>{{ campaign.progress.total }}</span> processed (<span data-percent>{{ campaign.progress.percent }}</span>%)</p><dl class="progress-stats">{% for key, label in {'accepted':'SMTP accepted', 'pending':'Waiting', 'retry':'Retrying', 'permanent_failure':'Failed', 'processing':'In progress', 'suppressed':'Suppressed', 'ambiguous':'Uncertain', 'cancelled':'Cancelled'} %}<div><dt>{{ label }}</dt><dd data-count="{{ key }}">{{ campaign.progress.counts[key] }}</dd></div>{% endfor %}</dl><p data-progress-updated></p><p data-progress-feedback role="status" aria-live="polite"></p></div>
<p class="help">SMTP acceptance does not prove inbox placement. Suppression and unsubscribe checks apply immediately before delivery.</p>
<div class="actions">{% if campaign.state == 'approved' %}<form method="post" action="{{ path('admin_campaign_queue', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-queue-' ~ campaign.id) }}"><button>Send now</button></form>{% endif %}
{% if campaign.state in ['queueing', 'sending'] %}<form method="post" action="{{ path('admin_campaign_pause', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-pause-' ~ campaign.id) }}"><button class="secondary">Pause</button></form>{% endif %}
{% if campaign.state == 'paused' %}<form method="post" action="{{ path('admin_campaign_resume', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-resume-' ~ campaign.id) }}"><button>Resume</button></form>{% endif %}
{% if campaign.state in ['approved', 'scheduled', 'queueing', 'sending', 'paused'] %}<form method="post" action="{{ path('admin_campaign_cancel', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-cancel-' ~ campaign.id) }}"><button class="danger">Cancel remaining</button></form>{% endif %}</div>
</section>
{% if campaign.state == 'approved' %}<section class="panel"><h2>Schedule</h2><form method="post" action="{{ path('admin_campaign_schedule', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-schedule-' ~ campaign.id) }}"><label>Date and time ({{ campaign.review.time_zone }}) <input type="datetime-local" name="scheduled_at" required></label><button>Schedule campaign</button></form></section>{% endif %}
<section class="panel"><h2>Campaign summary</h2><dl><dt>Recipient snapshot</dt><dd>{{ campaign.recipient_count }}</dd><dt>Currently suppressed</dt><dd>{{ campaign.review.suppressed_count }}</dd><dt>Template</dt><dd>{{ campaign.template_version_id ? campaign.template_name ~ ' · version ' ~ campaign.template_version : 'Not selected' }}</dd><dt>Sender</dt><dd>{{ campaign.review.sender_name }} &lt;{{ campaign.review.sender_address }}&gt;</dd><dt>Tracking</dt><dd>{{ campaign.review.tracking }}</dd><dt>RSVP</dt><dd>{{ campaign.review.rsvp }}</dd><dt>Approved</dt><dd>{{ campaign.approved_at ? campaign.approved_at|date('j M Y, g:i a', campaign.review.time_zone) : 'Not yet' }}</dd></dl></section>
{% if campaign.state in ['draft', 'paused'] %}<section class="panel"><h2>Sending rate</h2><form method="post" action="{{ path('admin_campaign_rate', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-rate-' ~ campaign.id) }}"><label>Messages per minute <input name="messages_per_minute" type="number" min="1" max="600" value="{{ campaign.messages_per_minute }}" placeholder="{{ campaign.delivery_limits.messages_per_minute }}"></label><button>Save rate</button></form></section>{% endif %}
{% if campaign.state == 'draft' %}<section class="panel"><h2>RSVP</h2><form method="post" action="{{ path('admin_campaign_rsvp', {id: campaign.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('campaign-rsvp-' ~ campaign.id) }}"><label><input type="checkbox" name="enabled" value="1"{% if campaign.rsvp_enabled %} checked{% endif %}> Enable RSVP</label><button>Save RSVP setting</button></form></section>{% endif %}
{% endblock %}
