{% extends 'admin/layout.html.twig' %}
{% block title %}Template versions — Emailer Light{% endblock %}
{% block admin_body %}<h1>Immutable versions</h1>
<form method="post" action="{{ path('admin_template_version_create', {id: template_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('template-version-create-' ~ template_id) }}"><label>Subject <input name="subject" maxlength="200" required></label><label>Preheader <input name="preheader" maxlength="200"></label><label>HTML <textarea name="html_body" maxlength="200000" rows="12" required></textarea></label><label>Plain text <textarea name="text_body" maxlength="100000" rows="8"></textarea></label><button type="submit">Create new version</button></form>
<table><thead><tr><th scope="col">Version</th><th scope="col">Subject</th><th scope="col">Published</th><th scope="col">Actions</th></tr></thead><tbody>{% for version in versions %}<tr><td>{{ version.version_number }}</td><td>{{ version.subject }}</td><td>{{ version.published_at ?: 'No' }}</td><td><a href="{{ path('admin_template_preview', {versionId: version.id}) }}">Synthetic preview</a><form method="post" action="{{ path('admin_template_test', {versionId: version.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('template-test-' ~ version.id) }}"><button type="submit">Run fake-only test</button></form><form method="post" action="{{ path('admin_template_publish', {id: template_id, versionId: version.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('template-publish-' ~ version.id) }}"><button type="submit">Publish</button></form></td></tr>{% endfor %}</tbody></table>{% endblock %}
