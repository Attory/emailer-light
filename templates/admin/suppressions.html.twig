{% extends 'admin/layout.html.twig' %}
{% block title %}Suppressions — Emailer Light{% endblock %}
{% block admin_body %}<h1>Global suppression</h1><p>Suppression is add-only. There is no bypass or removal action.</p><form method="post" action="{{ path('admin_suppression_add') }}"><input type="hidden" name="_token" value="{{ csrf_token('suppression-add') }}"><label>Email <input type="email" name="email" maxlength="254" required></label><label>Reason <select name="reason"><option value="manual">Manual</option><option value="complaint">Complaint</option><option value="hard_bounce">Hard bounce</option><option value="imported">Imported</option></select></label><button type="submit">Suppress globally</button></form><table><thead><tr><th scope="col">Address</th><th scope="col">Reason</th><th scope="col">Source</th><th scope="col">Created</th></tr></thead><tbody>{% for item in suppressions %}<tr><td>{{ item.email_display }}</td><td>{{ item.reason }}</td><td>{{ item.source }}</td><td>{{ item.created_at }}</td></tr>{% else %}<tr><td colspan="4">No suppressions.</td></tr>{% endfor %}</tbody></table>{% endblock %}
