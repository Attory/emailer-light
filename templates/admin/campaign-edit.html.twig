{% extends 'admin/layout.html.twig' %}
{% block title %}Edit campaign{% endblock %}
{% block javascripts %}<script type="module" src="{{ asset('campaign-editor.js') }}"></script>{% endblock %}
{% block admin_body %}
<p><a href="{{ path('admin_campaigns') }}">← Your campaigns</a>{% if campaign.name %} · <a href="{{ path('admin_campaign', {id: campaign.id}) }}">Campaign summary</a>{% endif %}</p>
<h1>{{ campaign.name ? 'Edit ' ~ campaign.name : 'Complete your campaign draft' }}</h1>
<p>Recipients and content remain editable until approval. Saving invalidates older campaign tests.</p>
{% set values = form_values ?? {name: campaign.name, template_version: campaign.template_version_id, messages_per_minute: campaign.messages_per_minute} %}
<section class="panel">{% include 'admin/_campaign-editor.html.twig' %}</section>
{% endblock %}
