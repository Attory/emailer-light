{% extends 'admin/layout.html.twig' %}
{% block title %}Campaigns — Emailer Light{% endblock %}
{% block javascripts %}<script type="module" src="{{ asset('campaign-editor.js') }}"></script>{% endblock %}
{% block admin_body %}
{% set values = form_values|default({}) %}
<div class="page-heading"><div><p class="eyebrow">Campaigns</p><h1>Your campaigns</h1><p>Each campaign owns its recipients. Upload a CSV for this campaign, then preview, test and approve it.</p></div><a class="button" href="#compose">Create a campaign</a></div>
<section class="panel"><h2>History</h2>
{% if campaigns %}<table><thead><tr><th>Campaign</th><th>Status</th><th>Recipients</th><th>Accepted</th><th>Failures</th><th>Updated</th></tr></thead><tbody>
{% for campaign in campaigns %}<tr><td><a href="{{ path('admin_campaign', {id: campaign.id}) }}">{{ campaign.name ?: 'Untitled campaign draft' }}</a></td><td>{{ campaign.state|replace({'_': ' '})|title }}</td><td>{{ campaign.recipient_count }}</td><td>{{ campaign.accepted_count|default(0) }}</td><td>{{ campaign.failure_count|default(0) }}</td><td>{{ campaign.updated_at|date('d M Y, H:i') }}</td></tr>{% endfor %}
</tbody></table>{% else %}<p>No campaigns yet.</p>{% endif %}
</section>
<section class="panel" id="compose"><h2>Create a campaign</h2>
{% include 'admin/_campaign-editor.html.twig' with {campaign: null, values: values} %}
</section>
{% endblock %}
