{% extends 'base.html.twig' %}
{% block title %}Sign in — Emailer Light{% endblock %}
{% block body %}
<main class="auth-shell">
    <img class="auth-brand" src="{{ asset('identity/emailer-lockup-light.svg') }}" alt="Emailer Light" width="670" height="205">
    <h1>Sign in</h1>
    {% if expiry_notice == 'idle' %}<p class="alert" role="alert">You’ve been signed out due to inactivity. Sign in again to continue.</p>
    {% elseif expiry_notice == 'absolute' %}<p class="alert" role="alert">Your session reached its 12-hour limit. Sign in again to continue.</p>{% endif %}
    {% if error %}<p class="alert" role="alert">Authentication failed.</p>{% endif %}
    <form method="post" action="{{ path('identity_login') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('identity-login') }}">
        <label>Administrator email <input type="email" name="login_identifier" value="{{ last_login }}" autocomplete="username" required></label>
        <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
        <button type="submit">Sign in</button>
    </form>
    <p>For password recovery, use the protected local CLI command documented in the operator runbook.</p>
</main>
{% endblock %}
