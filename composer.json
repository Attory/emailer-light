{
    "name": "attory/emailer-light",
    "description": "Emailer Light: a single-administrator self-hosted campaign mailer with campaign-owned CSV recipients.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4 <8.6",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-hash": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/stimulus-bundle": "^3.3",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.21",
        "ext-posix": "*"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.2",
        "symfony/flex": "^2.7",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "platform-check": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "discard-changes": true,
        "optimize-autoloader": true,
        "policy": {
            "advisories": {
                "block": true
            },
            "abandoned": {
                "block": true
            }
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "check:composer": [
            "@composer validate --strict",
            "@composer audit --locked --abandoned=fail",
            "@php tools/quality/check-license-policy.php"
        ],
        "check:style": "php-cs-fixer --using-cache=no fix --dry-run --diff",
        "check:static": [
            "phpstan analyse --memory-limit=512M",
            "deptrac analyse --no-progress --cache-file=var/cache/deptrac.cache",
            "@php tools/quality/check-module-boundaries.php",
            "@php -l tools/quality/check-license-policy.php",
            "@php -l tools/release/build-package.php",
            "@php -l tools/release/verify-package.php",
            "@php -l tools/release/generate-release-keypair.php",
            "@php -l tools/security/check-master-key-access.php"
        ],
        "test": "phpunit",
        "check:migrations": "bash tools/quality/check-migrations.sh",
        "check:artifact": [
            "bash tools/artifact/build.sh",
            "bash tools/security/scan-secrets.sh",
            "bash tools/security/scan-private-data.sh",
            "bash tools/artifact/inspect.sh",
            "bash tools/artifact/probe-public.sh",
            "bash tools/artifact/probe-deployment-profiles.sh"
        ],
        "check:shell": "bash tools/quality/check-shell.sh",
        "check": [
            "@check:composer",
            "@check:style",
            "@check:static",
            "@check:shell",
            "@check:migrations",
            "@test",
            "@check:artifact"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "runtime": {
            "disable_dotenv": true
        },
        "symfony": {
            "allow-contrib": false,
            "docker": false,
            "require": "7.4.*"
        }
    }
}
