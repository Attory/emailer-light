# Placeholder-only runtime schema. Symfony Dotenv loading is disabled; supply
# non-production values through an external runtime mechanism. Never put
# credentials or private data in Git.

APP_ENV=dev
APP_DEBUG=0
APP_SECRET=
DEFAULT_URI=https://emailer.example.test

# Use only a local development database. Docker Compose supplies its own fixed,
# synthetic values, so no copied file is needed for the safe container workflow.
DATABASE_URL=

# Writable runtime state must remain outside public/.
EMAILER_PRIVATE_DIR=/srv/emailer-light-private

# Required for production first-run setup. Use an absolute path outside the
# complete application/release/public tree. Every existing ancestor must have
# safe ownership and permissions; the immediate parent is mode 0700 and the key
# is mode 0600. Never store it in the database, repository, ordinary backup,
# command line, session, cache, queue, or log.
EMAILER_SECRET_KEY_FILE=/etc/emailer-light/master.key
# Store this separately from both the release tree and encrypted backups.
EMAILER_RECOVERY_KEY_FILE=/etc/emailer-light/recovery-key.enxkey
# Release update verification trusts only this externally provisioned public key.
EMAILER_RELEASE_PUBLIC_KEY_FILE=/etc/emailer-light/release-signing.pub
# Immutable semantic-version directories live here; `current` is atomically switched.
EMAILER_RELEASES_DIR=/srv/emailer-light/releases
# Optional Optional approved filesystem-mounted external backup destination.
# Provision this absolute directory outside both the release and private state
# trees with restrictive ownership. Leave empty until the administrator enables it.
EMAILER_BACKUP_DESTINATION_DIR=
TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_HOSTS=^(localhost|127\.0\.0\.1|\[::1\])$

# Development and tests use Mailpit. The test kernel accepts only Mailpit on port
# 1025 and rejects credentials, options, and every other SMTP destination.
MAILER_DSN=smtp://mailpit:1025
MESSENGER_TRANSPORT_DSN=doctrine://default
LOCK_DSN=flock
